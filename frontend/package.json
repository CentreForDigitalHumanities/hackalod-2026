{
    "name": "hackalod",
    "scripts": {
        "start": "yarn serve",
        "build": "ng build --base-href=/static/",
        "watch": "ng build --watch",
        "test": "ng test --watch=true",
        "prebuild": "node ./build/build-pre.js",
        "i18n": "ng extract-i18n --output-path locale",
        "preserve": "yarn prebuild",
        "serve": "ng serve",
        "serve:nl": "ng serve --configuration=nl",
        "stop": "lsof -t -i tcp:4200 | xargs kill -9 || echo \"not running\"",
        "pretest": "yarn prebuild",
        "test-once": "ng test --watch=false"
    },
    "private": true,
    "packageManager": "yarn@1.22.22",
    "dependencies": {
        "@angular/animations": "^22.2.4",
        "@angular/common": "^21.2.0",
        "@angular/compiler": "^21.2.0",
        "@angular/core": "^21.2.0",
        "@angular/forms": "^21.2.0",
        "@angular/platform-browser": "^21.2.0",
        "@angular/router": "^21.2.0",
        "@fortawesome/angular-fontawesome": "^4.0.0",
        "@fortawesome/fontawesome-svg-core": "^7.1.0",
        "@fortawesome/free-solid-svg-icons": "^7.1.0",
        "@ng-bootstrap/ng-bootstrap": "^20.0.0",
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.8",
        "colors": "^1.4.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "underscore": "^1.13.8"
    },
    "devDependencies": {
        "@angular/build": "^21.2.29",
        "@angular/cli": "^21.2.29",
        "@angular/compiler-cli": "^21.2.0",
        "@angular/localize": "^21.2.25",
        "@types/underscore": "^1.13.0",
        "jsdom": "^28.0.0",
        "ng-extract-i18n-merge": "^3.2.1",
        "prettier": "^3.8.1",
        "typescript": "~5.9.2",
        "vitest": "^4.0.8"
    }
}
